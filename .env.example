APP_NAME=DuolinTing Backend
APP_HOST=127.0.0.1
APP_PORT=8100
APP_SCHEMA=http
APP_ROUTE_PREFIX=/api
APP_BANNER=true
APP_ENV=development
APP_BACKEND_URL=http://127.0.0.1:8100
CORS_ORIGINS=http://127.0.0.1:8101,http://localhost:8101,http://127.0.0.1:8102,http://localhost:8102
VITE_API_BASE_URL=http://127.0.0.1:8100
# 学习端“贡献内容”页面收件邮箱；未设置时使用下方邮箱。
VITE_CONTRIBUTION_EMAIL=veejaliu@outlook.com
AUTH_TOKEN_SECRET=dev-auth-token-secret
SECRET_JWT=dev-auth-token-secret
LOG_LEVEL=info
LOG_JSON=false
LOG_OUTPUT=dev
MONITOR_ENABLED=false
MONITOR_ROUTE=/status
MONITOR_USERNAME=admin
MONITOR_PASSWORD=admin

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=duolinting_app_dev
MYSQL_USER=root
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_LOGGING=false
MYSQL_ROOT_PASSWORD=duolinting-root

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=duolinting-media
MINIO_REGION=us-east-1
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
RESEND_API_KEY=

WHISPER_MODEL=base
WHISPER_PYTHON=python3

# 智谱 AI 翻译（Admin 制课工作台）
# 在 https://open.bigmodel.cn 注册后获取 API Key；留空则 AI 翻译不可用。
ZHIPU_API_KEY=
# 可选，默认 glm-4-flash（永久免费）
ZHIPU_MODEL=
