APP_NAME=DuolinTing Backend
APP_HOST=127.0.0.1
APP_PORT=8100
APP_SCHEMA=http
APP_ROUTE_PREFIX=/api
APP_BANNER=true
APP_ENV=development
APP_BACKEND_URL=http://127.0.0.1:8100
CORS_ORIGINS=http://127.0.0.1:8101,http://localhost:8101,http://127.0.0.1:8102,http://localhost:8102
VITE_API_BASE_URL=http://127.0.0.1:8100
# Web 学习端在移动浏览器中引导用户打开 Expo Mobile Web 的地址；生产值仅放私有 .env。
VITE_MOBILE_APP_URL=http://127.0.0.1:8103
# 学习端“贡献内容”页面收件邮箱；未设置时使用下方邮箱。
VITE_CONTRIBUTION_EMAIL=veejaliu@outlook.com
AUTH_TOKEN_SECRET=dev-auth-token-secret
SECRET_JWT=dev-auth-token-secret
LOG_LEVEL=info
LOG_JSON=false
LOG_OUTPUT=dev
MONITOR_ENABLED=false
MONITOR_ROUTE=/status
MONITOR_USERNAME=admin
MONITOR_PASSWORD=admin

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=duolinting_app_dev
MYSQL_USER=root
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_LOGGING=false
MYSQL_ROOT_PASSWORD=duolinting-root

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=duolinting-media
MINIO_REGION=us-east-1
# 媒体对象存储。默认 minio 并回退读取上面的 MINIO_*，保持本地开发兼容。
# 腾讯 COS 示例：provider=cos、endpoint=cos.ap-shanghai.myqcloud.com、port=443、
# useSSL=true、pathStyle=false；真实访问密钥只能写入忽略的本地/服务器 .env。
MEDIA_STORAGE_PROVIDER=minio
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_PORT=
MEDIA_STORAGE_USE_SSL=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_REGION=
MEDIA_STORAGE_PATH_STYLE=
# 可选：公开媒体入口。COS/R2 自定义域名直接映射对象键；MinIO 历史路径默认
# 包含 bucket。留空则继续由 /api/v1/media/objects 提供媒体。
MEDIA_PUBLIC_BASE_URL=
MEDIA_PUBLIC_URL_INCLUDES_BUCKET=
# 开启后，游客目录不返回媒体地址，媒体只通过短时签名 URL 加载。
# 腾讯 CDN 使用 tencent-type-a；无 CDN 的本地私有环境可用 backend-token。
MEDIA_REQUIRE_AUTH=false
MEDIA_AUTH_MODE=backend-token
MEDIA_AUTH_KEY=
MEDIA_AUTH_TTL_SECONDS=3600
RESEND_API_KEY=
# Transactional sender. Keep the API key in an ignored local .env; the sender
# must belong to a domain verified in the matching Resend account.
RESEND_FROM_EMAIL=no-reply@mail.duolinting.cn
RESEND_FROM_NAME=DuolinTing
EMAIL_PUBLIC_SITE_URL=https://www.duolinting.cn
# Optional monitored inbox for replies. Leave empty for no Reply-To header.
RESEND_REPLY_TO=

# 仅本机开发的上传进度演练。默认 0 为关闭；生产环境和非环回请求会强制忽略。
# 例如 256 代表将媒体/封面上传限制为约 256 KB/s，方便观察前端进度条。
LOCAL_UPLOAD_THROTTLE_KBPS=0
# 文件发送与对象存储写入完成后，额外等待多久再返回成功，用于测试“等待服务器确认”。
LOCAL_UPLOAD_CONFIRMATION_DELAY_MS=0

WHISPER_MODEL=base
WHISPER_PYTHON=python3
