  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:playback": "node --conditions=import --import tsx --test tests/*.test.ts",
    "start": "expo start --port 8103",
    "start:logged": "script -q -a ../temp/expo-mobile.log sh -c 'expo start --port 8103 \"$@\"' --",
    "android": "expo start --android --port 8103",
    "ios": "expo start --ios --port 8103",
    "web": "expo start --web --port 8103",
    "build": "expo export --platform web --output-dir dist",
    "postinstall": "sh -c 'if [ -f ../packages/domain/tsconfig.json ]; then cd .. && npm run build:mobile-dependencies; fi'"
  },
  "private": true
