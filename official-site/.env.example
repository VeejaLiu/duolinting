# Public learner-web URL for the build environment. Do not use a loopback URL
# for a production build: it would refer to each visitor's own device.
VITE_LEARNER_APP_URL=https://your-learner-app.example.com

# Public canonical origin used for sitemap, robots and social metadata.
VITE_OFFICIAL_SITE_URL=https://www.duolinting.cn
