# Admin/Backend origin that exposes /api/v1/open-content/*.
DUOLINTING_API_BASE=http://127.0.0.1:8102
# DUOLINTING_BACKEND_URL is accepted as an alias when the API base is not set.

# Create this in Admin > 开放内容 API. Never commit the real value.
DUOLINTING_OPEN_CONTENT_API_KEY=dltak_replace_with_the_key_shown_once

# Local source media. The open-content API intentionally does not expose media URLs.
DUOLINTING_VIDEO_MEDIA_DIR=./media

# Optional output/cache locations.
DUOLINTING_VIDEO_CACHE_DIR=./cache
DUOLINTING_VIDEO_OUTPUT_DIR=./output

# The normal FFmpeg build may not include the subtitles/libass filter.
# ffmpeg-full is keg-only on Homebrew; use these instead of changing PATH if needed.
# DUOLINTING_FFMPEG_BIN=/path/from/brew--prefix/ffmpeg-full/bin/ffmpeg
# DUOLINTING_FFPROBE_BIN=/path/from/brew--prefix/ffmpeg-full/bin/ffprobe
