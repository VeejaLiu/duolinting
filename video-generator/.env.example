# Admin/Backend origin that exposes /api/v1/open-content/*.
DUOLINTING_API_BASE=http://127.0.0.1:8102
# DUOLINTING_BACKEND_URL is accepted as an alias when the API base is not set.

# Create this in Admin > 开放内容 API. Never commit the real value.
DUOLINTING_OPEN_CONTENT_API_KEY=dltak_replace_with_the_key_shown_once

# Optional overrides for local source media, cache, and output locations.
# By default these stay inside the video-generator/ project directory.
# DUOLINTING_VIDEO_MEDIA_DIR=/path/to/media
# DUOLINTING_VIDEO_CACHE_DIR=/path/to/cache
# DUOLINTING_VIDEO_OUTPUT_DIR=/path/to/output

# The FFmpeg build must include the subtitles/libass filter.
# Apple Silicon macOS: brew install ffmpeg-full.
# Intel macOS: install MacPorts, then run: sudo port install ffmpeg.
# Use these instead of changing PATH if needed.
# DUOLINTING_FFMPEG_BIN=/path/from/brew--prefix/ffmpeg-full/bin/ffmpeg
# DUOLINTING_FFPROBE_BIN=/path/from/brew--prefix/ffmpeg-full/bin/ffprobe
